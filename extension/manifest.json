{
  "manifest_version": 2,
  "name": "Vitrina",
  "version": "1.1.1",
  "description": "Min-style interface with fluid ink glass aesthetics, dynamic site accent colors, and tactile island tabs",
  "browser_specific_settings": {
    "gecko": {
      "id": "vitrina@local",
      "strict_min_version": "140.0"
    }
  },
  "experiment_apis": {
    "vitrina": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["vitrina"]],
        "script": "api.js"
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ],
  "browser_action": {
    "default_title": "Vitrina Themes",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage"
  ]
}
